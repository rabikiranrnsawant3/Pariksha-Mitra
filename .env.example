PORT=3000
NODE_ENV=development
# Generate a random secret with at least 32 characters. Never commit your real .env.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
DB_FILE=./pareekshasetu.sqlite

# Development only: prints OTP in the server terminal; does NOT send SMS.
DEMO_OTP=true

# For real SMS OTP, create a Twilio Verify service and fill these values.
# When all three are present, Twilio Verify is used instead of development OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
